<!--
  four_states — SimpleAct-style chart with compound root (fourStates::root).
  lowerCamelCase state ids; PascalCase event names. Mirror: four_states.uxf.
-->
<scxml initial="root" name="four_states" version="0.9" xmlns="http://www.w3.org/2005/07/scxml">
    <state id="root" initial="stopped">
        <transition event="SimpleActStopReq" target="stopping"/>
        <transition event="SimpleActStartReq"/>
        <state id="stopped">
            <transition event="SimpleActStartReq" target="starting"/>
            <transition event="SimpleActStopReq"/>
        </state>
        <state id="starting">
            <transition event="Done" target="started"/>
            <transition event="Failed" target="stopping"/>
        </state>
        <state id="started"/>
        <state id="stopping">
            <transition event="Done" target="stopped"/>
            <transition event="Failed" target="fault"/>
        </state>
        <state id="fault"/>
    </state>
</scxml>
